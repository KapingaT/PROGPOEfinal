@model IEnumerable<RacedayFINAL.Models.EventViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<h2>Organiser Dashboard</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<a asp-action="CreateEvent" class="btn btn-success mb-3">+ Create New Event</a>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Event Name</th>
            <th>Date</th>
            <th>Location</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ev in Model)
        {
            <tr>
                <td>@ev.Name</td>
                <td>@ev.Date.ToString("dd MMM yyyy")</td>
                <td>@ev.Location</td>
                <td>
                    <!-- Link to view enrolments or capture results -->
                    <a asp-action="CaptureResults" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-primary">Capture Results</a>
                </td>
            </tr>
        }
    </tbody>
</table>